# Copy to .env and fill in real values. Never commit .env.
ADDR=:8080
APP_ENV=development
DATABASE_URL=postgres://tyrako:tyrako@localhost:5432/tyrako?sslmode=disable
ALLOW_ORIGINS=http://localhost:3000
READ_TIMEOUT=15s
WRITE_TIMEOUT=35s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
TRUEMONEY_API_BASE_URL=https://gift.truemoney.com
TRUEMONEY_API_TIMEOUT=30s
# Seed API key registered at startup when the key store is empty (full scopes).
# If left empty in development, a random key is generated and logged.
# BOOTSTRAP_API_KEY=
RATE_LIMIT_ENABLED=true
# Per-key rate limit by key rank: member 60 req/min, partner 1000 req/min,
# admin unlimited. Windows of both tiers share RATE_LIMIT_WINDOW.
RATE_LIMIT_MEMBER_MAX=60
RATE_LIMIT_PARTNER_MAX=1000
RATE_LIMIT_WINDOW=1m
# Per-IP limit for unauthenticated requests (mounted before auth)
RATE_LIMIT_IP_ENABLED=true
RATE_LIMIT_IP_MAX=1000
RATE_LIMIT_IP_WINDOW=1m
# Trust X-Forwarded-For from a reverse proxy (set true behind Caddy/nginx)
TRUST_PROXY_HEADERS=false
# Redis for shared rate limiting (multi-instance). Empty = in-memory limiter.
REDIS_URL=redis://localhost:6379/0

