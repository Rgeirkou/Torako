# Production environment template. Copy to .env.production on the server and
# fill in real secrets. Never commit this file.

# Public domain served by Caddy (automatic HTTPS). Point DNS A/AAAA record to
# the server first, e.g. api.example.com
DOMAIN=

# Database password (postgres)
POSTGRES_PASSWORD=change-me-strong-password

# Redis password (redis runs with --requirepass). Use alphanumeric only:
# special characters like @ or / would break the REDIS_URL in the compose file.
REDIS_PASSWORD=change-me-another-strong-password

# API listen address inside the container (keep :8080)
ADDR=:8080
APP_ENV=production

# CORS: comma-separated origins of your frontend, e.g. https://app.example.com
ALLOW_ORIGINS=

# Seed API key with full scopes, registered on first start.
# REQUIRED in production — the server refuses to start without it.
BOOTSTRAP_API_KEY=change-me-strong-bootstrap-key

# Rate limiting (per API key by rank, stored in Redis): member 60 req/min,
# partner 1000 req/min, admin unlimited.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MEMBER_MAX=60
RATE_LIMIT_PARTNER_MAX=1000
RATE_LIMIT_WINDOW=1m

# Per-IP limit for unauthenticated requests (mounted before auth)
RATE_LIMIT_IP_ENABLED=true
RATE_LIMIT_IP_MAX=1000
RATE_LIMIT_IP_WINDOW=1m

# Trust X-Forwarded-For from the reverse proxy (Caddy). The compose file
# forces this to true for the api service.
TRUST_PROXY_HEADERS=true

